<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_gravity="center"
        android:fontFamily="@font/super_bouncer"
        android:text="Seleccionar sitios"
        android:textColor="@color/black"

        android:textSize="25sp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/grupoFiltros"
        android:layout_width="310dp"
        android:layout_height="wrap_content"

        android:layout_gravity="center"
        app:chipSpacing="8dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipWalmart"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:checkable="true"
            android:checked="true"
            android:padding="50dp"
            android:text="Walmart"
            android:textColor="@color/secondary"
            app:chipBackgroundColor="@color/black"
            app:chipStrokeWidth="0.3dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSelectos"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:checkable="true"
            android:text="Super Selectos"
            android:textColor="@color/black"
            app:chipBackgroundColor="@color/secondary"
            app:chipStrokeWidth="0.3dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipCuracao"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:checkable="true"
            android:text="Curacao"
            android:textColor="@color/black"
            app:chipBackgroundColor="@color/secondary"
            app:chipStrokeWidth="0.3dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipDespensa"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:checkable="true"
            android:gravity="center"
            android:text="Despensa de Don Juan"
            android:textColor="@color/black"

            app:chipBackgroundColor="@color/secondary"
            app:chipStrokeWidth="0.3dp" />


    </com.google.android.material.chip.ChipGroup>
</LinearLayout>